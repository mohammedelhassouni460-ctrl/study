# =============================================================================
# StudyOS AI : variables d'environnement
# Copie ce fichier en `.env.local` (jamais commité) et remplis les valeurs.
# Seules les variables NEXT_PUBLIC_* sont exposées au navigateur.
# =============================================================================

# --- Application -------------------------------------------------------------
# URL publique (sert aux redirections d'auth et de paiement).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (obligatoire) --------------------------------------------------
# Local : affichées par `npm run db:start`. Cloud : Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET, serveur uniquement : crédits IA, webhooks Stripe, suppression de compte.
# Ne jamais la préfixer par NEXT_PUBLIC_ ni l'utiliser dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA : Anthropic (obligatoire pour les fonctions IA) ----------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Modèle utilisé pour fiches, flashcards, quiz et chat.
ANTHROPIC_MODEL=claude-opus-5-5

# --- Embeddings (facultatif, améliore la recherche du chat) ------------------
# Sans clé, le chat utilise la recherche plein-texte de Postgres.
# voyage | openai | none (par défaut : détecté selon la clé présente)
EMBEDDINGS_PROVIDER=
# https://dash.voyageai.com/ (recommandé, modèle voyage-3.5 en 1024 dimensions)
VOYAGE_API_KEY=
# Alternative : https://platform.openai.com/api-keys (text-embedding-3-small, 1024 dimensions)
OPENAI_API_KEY=

# --- Stripe (obligatoire pour l'abonnement Pro) ------------------------------
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` affiche un whsec_… en local.
STRIPE_WEBHOOK_SECRET=
# Prix récurrents du produit « StudyOS Pro » (9,99 €/mois et 79,99 €/an).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# --- Emails (facultatif : rappels de révision et bilan hebdomadaire) --------
# https://resend.com/api-keys ; sans clé, aucun email n'est envoyé.
RESEND_API_KEY=
# Expéditeur vérifié dans Resend (domaine à configurer).
EMAIL_FROM=StudyOS <bonjour@ton-domaine.fr>
# Secret des tâches planifiées (Vercel l'envoie en « Authorization: Bearer … »). 16 caractères minimum.
CRON_SECRET=

# --- Rate limiting (recommandé en production) --------------------------------
# Sans ces valeurs, la limite est gardée en mémoire (par instance).
# https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics (facultatif) --------------------------------------------------
# Sans clé, les événements ne sont pas envoyés.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
